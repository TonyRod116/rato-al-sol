{
  "expo": {
    "name": "Rato al Sol",
    "slug": "rato-al-sol",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "locales": {
      "es": {
        "ios": {
          "NSLocationWhenInUseUsageDescription": "Rato al Sol usa tu ubicación para encontrar lugares cerca de ti cuando tú lo pides."
        }
      },
      "en": {
        "ios": {
          "NSLocationWhenInUseUsageDescription": "Rato al Sol uses your location to find nearby places when you ask."
        }
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ratoalsol.app",
      "buildNumber": "9"
    },
    "android": {
      "package": "com.ratoalsol.app",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#faf7ee"
      }
    },
    "plugins": [
      "./plugins/fix-map-overlay",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rato al Sol usa tu ubicación para encontrar lugares cerca de ti cuando tú lo pides.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#faf7ee"
        }
      ]
    ],
    "owner": "tonyrods-team",
    "extra": {
      "eas": {
        "projectId": "218a788d-6681-4f43-b261-ea14818dce5d"
      }
    }
  }
}
